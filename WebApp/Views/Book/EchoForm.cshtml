<h2>Book search form</h2>

<form method="get" asp-controller="Book" asp-action="Echo">
    <label for="name">Nazwa ksiązki</label>
    <input name="name" type="text" placeholder="Nazwa">
    <label for="count">Liczba egzemplarzy</label>
    <input name="count" type="number" placeholder="Liczba">
    
    <button type="submit">Wyślij</button>
</form>